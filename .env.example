# Public HTTPS address of this server (no trailing slash). claude.ai connects to BASE_URL/mcp.
BASE_URL=https://inbox-connector.example.com
PORT=8787
# Where linked accounts are kept (encrypted). Use a persistent volume in production.
DATA_DIR=./data
# Random string, at least 32 characters. Encrypts stored sign-ins. Never change it after launch
# (people would have to add their accounts again). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=

# Who may connect the connector in claude.ai (their work identity). Comma-separated; empty = anyone.
ALLOWED_SIGNIN_DOMAINS=raptbot.in
# Which mailboxes may be added afterwards. Empty = any, including personal Gmail / Outlook.com.
ALLOWED_LINK_DOMAINS=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
# Redirect URI: BASE_URL/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID → App registrations. Redirect URI (Web): BASE_URL/oauth/callback/microsoft
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common = work and personal accounts; organizations = work only; or your tenant id
MS_TENANT=common

# api.slack.com/apps → OAuth & Permissions. Redirect URL: BASE_URL/oauth/callback/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
